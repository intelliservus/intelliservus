# 本地环境变量模板。
# 复制为 .env 后填入本地值；.env 已被 .gitignore 忽略，禁止提交（事实源 §14.2）。
# docker compose 会自动加载仓库根的 .env，用于 chatwoot profile 的插值。

# --- Chatwoot POC scratch 库（docker compose --profile chatwoot）---
# 仅用于本机一次性验证，随卷销毁，不承载任何生产凭证。
# 口令会拼进 DATABASE_URL，只能用 URL 安全字符，生成方式：
#   openssl rand -hex 24
POC_DB_USER=poc
POC_DB_PASSWORD=replace_with_openssl_rand_hex_24
POC_DB_NAME=poc

# --- 平台（saas-api + 平台库）---
# 本地默认值仅用于开发；生产由环境变量或 Secret 注入（事实源 §14.2）。
PLATFORM_DB_USER=platform
PLATFORM_DB_PASSWORD=replace_with_openssl_rand_hex_24
PLATFORM_DB_NAME=platform

# 至少 32 字符；生成方式：openssl rand -hex 32
JWT_SECRET=replace_with_openssl_rand_hex_32
# 逗号分隔；本地控制台为 http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080
# 本地 http 访问时为 false；部署到 https 时必须为 true
COOKIE_SECURE=false
